---
layout: base.njk
title: "Group Booking: Bridal, Birthdays & Parties | Polished Nail Bar DTLA"
permalink: /group-booking/
eleventyComputed:
  description: "{{ group.seo_description }}"
---
<section class="masthead">
  <div class="wrap">
    <span class="u10 mute">Group Booking &middot; Polished Nail Bar DTLA</span>
    <h1 class="mega">Bridal,<br>birthdays<br>&amp; girls' days</h1>
    <p class="lead">{{ group.hero_intro }}</p>
    {% if group.hero_note %}<p class="lead" style="margin-top:14px"><strong>{{ group.hero_note }}</strong></p>{% endif %}
    <div class="btns">
      {% for b in group.buttons %}
      <a class="btn{% if b.style == 'outline' %} btn-o{% endif %}" href="{{ b.link }}"{% if b.link.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ b.label }}</a>
      {% endfor %}
    </div>
  </div>
</section>

<div class="g gtrio">
  <div class="ph r11 zoom" data-l="Group photo 1 &middot; group-01.jpg">
    <img src="/images/group-01.jpg" alt="A group at Polished Nail Bar" onerror="this.remove()"></div>
  <div class="ph r11 zoom" data-l="Group photo 2 &middot; group-02.jpg">
    <img src="/images/group-02.jpg" alt="A group at Polished Nail Bar" onerror="this.remove()"></div>
  <div class="ph r11 zoom" data-l="Group photo 3 &middot; group-03.jpg">
    <img src="/images/group-03.jpg" alt="A group at Polished Nail Bar" onerror="this.remove()"></div>
</div>

<section class="sec wrap">
  <div class="sh rv">
    <div class="top"><span class="u10 mute">01 &mdash; How It Works</span><span class="u10 mute">Four steps</span></div>
    <h2 class="big">Booking your group</h2>
    <p class="say">Everything starts on our booking page. Once you've booked, a member of our team reaches out within 24 hours to confirm the details.</p>
  </div>
  <div class="steps rv">
    {% for s in group.steps %}
    <div class="step"><p>{{ s }}</p></div>
    {% endfor %}
  </div>
  {% if group.steps_note or group.steps_note_bold %}
  <p class="say rv" style="margin-top:22px"><strong>{{ group.steps_note_bold }}</strong> {{ group.steps_note }}</p>
  {% endif %}
  <div class="btns"><a class="btn" href="https://polisheddtla.glossgenius.com/services" target="_blank" rel="noopener">Go to booking</a></div>
</section>

<section class="sec dark on-dark">
  <div class="wrap">
    <div class="sh rv">
      <div class="top"><span class="u10 mute">02 &mdash; Perks &amp; Extras</span></div>
      <h2 class="big">What we can arrange</h2>
    </div>
    <div class="g g2 rv" style="gap:clamp(26px,3vw,44px)">
      <div class="perk"><h3>{{ group.perks_title }}</h3>
        <p>{{ group.perks_intro }}</p>
        {% for t in group.tiers %}
        <p style="margin-top:16px"><strong>{{ t.name }}</strong>{% if t.lead %}<br>{{ t.lead }}{% endif %}</p>
        <ul style="margin:6px 0 0 1.1em;padding:0;list-style:disc">
          {% for i in t.items %}<li>{{ i }}</li>{% endfor %}
        </ul>
        {% endfor %}
        {% if group.perks_fine_print %}<p style="margin-top:16px;font-size:.85em;opacity:.8">{{ group.perks_fine_print }}</p>{% endif %}
      </div>
      <div class="perk"><h3>{{ group.golden_hour_title }}</h3><p>{{ group.golden_hour }}</p></div>
    </div>
  </div>
</section>

<section class="sec wrap">
  <div class="sh rv">
    <div class="top"><span class="u10 mute">03 &mdash; Group Policy</span><a class="tl" href="/policies/">All policies</a></div>
    <h2 class="big">The details</h2>
    <p class="say">Group bookings work a little differently from a single appointment. Here's exactly what to expect.</p>
  </div>
  <div class="acc rv">
    {% for p in group.policies %}
    <div class="acc-i{% if loop.first %} open{% endif %}"><button class="acc-b" type="button" aria-expanded="{{ 'true' if loop.first else 'false' }}">{{ p.title }}<span class="sg"></span></button>
      <div class="acc-p"><p>{{ p.body }}</p></div></div>
    {% endfor %}
  </div>
</section>


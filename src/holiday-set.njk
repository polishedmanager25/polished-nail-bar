<div class="lbox" id="lbox" role="dialog" aria-modal="true" aria-label="Design preview">
  <button class="lb-close" type="button" aria-label="Close">×</button>
  <button class="lb-prev" type="button" aria-label="Previous design">‹</button>
  <figure><img id="lb-img" alt=""><figcaption><div class="t" id="lb-t"></div><div class="m" id="lb-m"></div></figcaption></figure>
  <button class="lb-next" type="button" aria-label="Next design">›</button>
</div>

{% raw %}<script>
(function(){
  var DEFAULT=document.body.getAttribute('data-default')||'classic', tiers=['simple','classic','glam'];
  // number every design in order: Simple, then Classic, then Glam
  var _n=0; tiers.forEach(function(k){document.querySelectorAll('#panel-'+k+' .card').forEach(function(c){_n++;c.querySelector('.num').textContent='#'+_n;var b=c.querySelector('.card-btn');b.setAttribute('data-title','#'+_n+' '+b.getAttribute('data-name'));});});
  var tabs=document.querySelectorAll('.tab');
  function show(t,scroll){
    if(tiers.indexOf(t)<0)t=DEFAULT;
    tabs.forEach(function(b){var on=b.dataset.tier===t;b.setAttribute('aria-selected',on);b.tabIndex=on?0:-1;});
    tiers.forEach(function(k){document.getElementById('panel-'+k).hidden=(k!==t);});
    if(scroll)document.getElementById('lookbook').scrollIntoView({behavior:'smooth'});
  }
  tabs.forEach(function(b,i){
    b.addEventListener('click',function(){show(b.dataset.tier);history.replaceState(null,'','#'+b.dataset.tier);});
    b.addEventListener('keydown',function(e){
      var d=e.key==='ArrowRight'?1:e.key==='ArrowLeft'?-1:0; if(!d)return;
      var n=tabs[(i+d+tabs.length)%tabs.length]; n.focus(); n.click();
    });
  });
  document.querySelectorAll('[data-jump]').forEach(function(a){
    a.addEventListener('click',function(e){e.preventDefault();show(a.dataset.jump,true);history.replaceState(null,'','#'+a.dataset.jump);});
  });
  var h=location.hash.slice(1);
  if(tiers.indexOf(h)>-1){show(h,true);}else{show(DEFAULT);}

  // occasion filter: one button per occasion that has photos (built automatically from the labels)
  var cards=Array.prototype.slice.call(document.querySelectorAll('.card')),occs=[],labels={};
  cards.forEach(function(c){if(occs.indexOf(c.dataset.occ)<0){occs.push(c.dataset.occ);labels[c.dataset.occ]=c.dataset.occLabel;}});
  var row=document.getElementById('occrow');
  function filt(o){
    row.querySelectorAll('.ochip').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.occ===o);});
    tiers.forEach(function(k){
      var p=document.getElementById('panel-'+k),n=0;
      p.querySelectorAll('.card').forEach(function(c){var on=(o==='all'||c.dataset.occ===o);c.hidden=!on;if(on)n++;});
      p.querySelector('.count').textContent=n+(n===1?' look':' looks');
      var e=p.querySelector('.empty'); if(!e){e=document.createElement('p');e.className='empty';p.appendChild(e);}
      e.textContent=n?'':'No looks for this occasion in this tier yet — try another tier.';
    });
  }
  var list0=occs.length>1?['all'].concat(occs):occs;
  list0.forEach(function(o){var b=document.createElement('button');b.type='button';b.className='ochip';b.dataset.occ=o;b.textContent=o==='all'?'All':labels[o];b.addEventListener('click',function(){filt(o);});row.appendChild(b);});
  if(occs.length===1){var m=document.createElement('span');m.className='osoon';m.textContent='More holidays coming soon';row.appendChild(m);}
  row.hidden=false; filt(occs.length>1?'all':occs[0]);

  // lightbox (moves within the open tier)
  var box=document.getElementById('lbox'),img=document.getElementById('lb-img'),tt=document.getElementById('lb-t'),mm=document.getElementById('lb-m'),list=[],idx=0,last;
  function render(){var b=list[idx];img.src=b.dataset.full;img.alt=b.dataset.title;tt.textContent=b.dataset.title;mm.textContent=b.dataset.meta;}
  function open(b){last=b;list=Array.prototype.slice.call(b.closest('.panel').querySelectorAll('.card:not([hidden]) .card-btn'));idx=list.indexOf(b);render();box.classList.add('open');document.body.style.overflow='hidden';box.querySelector('.lb-close').focus();}
  function close(){box.classList.remove('open');document.body.style.overflow='';if(last)last.focus();}
  function step(d){idx=(idx+d+list.length)%list.length;render();}
  document.querySelectorAll('.card-btn').forEach(function(b){b.addEventListener('click',function(){open(b);});});
  box.querySelector('.lb-close').onclick=close;
  box.querySelector('.lb-prev').onclick=function(){step(-1);};
  box.querySelector('.lb-next').onclick=function(){step(1);};
  box.addEventListener('click',function(e){if(e.target===box)close();});
  document.addEventListener('keydown',function(e){if(!box.classList.contains('open'))return;if(e.key==='Escape')close();if(e.key==='ArrowRight')step(1);if(e.key==='ArrowLeft')step(-1);});
  var sx=0;box.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
  box.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>45)step(dx<0?1:-1);});

  // mobile menu
  var mb=document.querySelector('.menu-btn'),nav=document.getElementById('mainnav');
  mb.addEventListener('click',function(){var o=nav.classList.toggle('open');mb.setAttribute('aria-expanded',o);});

  // GA4 tap events
  document.querySelectorAll('[data-ev]').forEach(function(a){a.addEventListener('click',function(){if(window.gtag)gtag('event',a.dataset.ev,{link_url:a.href,page:'holiday-set'});});});
})();
</script>{% endraw %}
</body>
</html>

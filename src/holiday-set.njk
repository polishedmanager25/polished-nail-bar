---
permalink: /holiday-set/index.html
layout: false
eleventyExcludeFromCollections: false
---
{%- set hs = holiday -%}
{% set tiers = [["simple","Simple",hs.prices.simple],["classic","Classic",hs.prices.classic],["glam","Glam",hs.prices.glam]] %}{% set deftier = (hs.default_tier or "Classic") | lower %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ hs.page_title }} — Gel-X + Nail Art from ${{ hs.prices.simple }} | Polished Nail Bar DTLA</title>
<meta name="description" content="{{ hs.meta_description }}">
<link rel="canonical" href="https://polishednailbardtla.com/holiday-set/">
<meta property="og:title" content="{{ hs.page_title }} — Gel-X + Nail Art from ${{ hs.prices.simple }} | Polished Nail Bar DTLA">
<meta property="og:description" content="Short Gel-X with nail art from our lookbook. Simple ${{ hs.prices.simple }} · Classic ${{ hs.prices.classic }} · Glam ${{ hs.prices.glam }}.">
<meta property="og:url" content="https://polishednailbardtla.com/holiday-set/">
<meta property="og:image" content="https://polishednailbardtla.com{{ hs.hero_image }}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..900&family=Cormorant+Garamond:ital,wght@1,600&display=swap" rel="stylesheet">
<!-- GA4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-62WJ1WYLE4"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-62WJ1WYLE4');</script>
{% raw %}<style>
:root{--ink:#141414;--white:#fff;--gold:#DCB63F;--gold-grad:linear-gradient(135deg,#F7E7A6 0%,#DCB63F 50%,#A9821F 100%);--coral:#F4B3AC;--sage:#C6D3C0;--line:#e7e7e7;--soft:#f7f7f5}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Jost',system-ui,sans-serif;color:var(--ink);background:var(--white);font-size:17px;line-height:1.55;padding-bottom:76px}
img{display:block;max-width:100%}
a{color:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 22px}
.display{font-family:'Anton',Impact,sans-serif;font-weight:400;letter-spacing:.01em;line-height:.95}
.accent{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:15px 26px;border-radius:999px;font-weight:600;font-size:15px;text-decoration:none;letter-spacing:.02em;transition:transform .2s,box-shadow .2s}
.btn-gold{background:var(--gold-grad);color:var(--ink);box-shadow:0 6px 18px rgba(169,130,31,.28)}
.btn-dark{background:var(--ink);color:#fff}
.btn-line{border:2px solid var(--ink);color:var(--ink)}
.btn:hover{transform:translateY(-2px)}

/* banner */
.banner{background:var(--ink);color:#fff;overflow:hidden;white-space:nowrap;font-size:13px;font-weight:600;letter-spacing:.12em}
.banner a{text-decoration:none}
.marquee{display:inline-flex;animation:scroll 38s linear infinite;padding:10px 0}
.marquee span{padding:0 28px}
.marquee .hl{background:var(--gold-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* header */
header.site{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.hdr{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo img{height:44px;width:auto}
nav.main{display:flex;gap:18px;font-size:14px;font-weight:500;white-space:nowrap}
nav.main a{text-decoration:none;padding:6px 0;position:relative}
nav.main a[aria-current]{font-weight:700}
nav.main a[aria-current]::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--gold-grad)}
.hdr .btn{padding:11px 20px;font-size:14px}
.menu-btn{display:none;background:none;border:0;font:600 14px 'Jost',sans-serif;cursor:pointer}
@media(max-width:1240px){nav.main{display:none;position:absolute;top:68px;left:0;right:0;background:#fff;flex-direction:column;gap:0;padding:8px 22px 18px;border-bottom:1px solid var(--line)}nav.main.open{display:flex}nav.main a{padding:11px 0;border-bottom:1px solid var(--soft)}.menu-btn{display:block}.hdr .btn{display:none}}

/* hero */
.hero{padding:56px 0 40px}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center}
.eyebrow{font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#6b6b6b;margin-bottom:16px}
.hero h1{font-size:clamp(64px,10vw,132px);text-transform:uppercase}
.hero h1 .g{background:var(--gold-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p.lede{font-size:clamp(19px,2vw,23px);font-weight:500;max-width:30ch;margin:22px 0 28px}
.hero .from{display:block;font-size:28px;margin-bottom:22px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.hero-img{border-radius:22px;overflow:hidden;aspect-ratio:4/5;background:var(--soft)}
.hero-img img{width:100%;height:100%;object-fit:cover}
@media(max-width:820px){.hero-grid{grid-template-columns:1fr}.hero{padding-top:34px}.hero-img{aspect-ratio:4/3;order:-1}}

section{padding:56px 0}
.sec-num{font-size:13px;font-weight:700;letter-spacing:.18em;color:#6b6b6b;margin-bottom:10px}
h2{font-size:clamp(40px,5.5vw,68px);text-transform:uppercase;margin-bottom:26px}

/* prices */
.prices{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.price-card{display:flex;flex-direction:column;gap:4px;padding:26px 24px;border:2px solid var(--ink);border-radius:20px;text-decoration:none;transition:transform .2s,background .2s}
.price-card:hover{transform:translateY(-3px);background:var(--soft)}
.pc-l{font-size:15px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.pc-p{font-family:'Anton',sans-serif;font-size:62px;line-height:1}
.pc-go{font-size:14px;font-weight:600;margin-top:8px}
.price-card:nth-child(3){background:var(--ink);color:#fff}
.price-card:nth-child(3) .pc-p{background:var(--gold-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.price-card:nth-child(3):hover{background:#222}
.price-note{margin-top:16px;font-size:15px;color:#4a4a4a}
@media(max-width:720px){.prices{grid-template-columns:1fr}.pc-p{font-size:52px}}

/* steps */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;list-style:none;counter-reset:s}
.steps li{background:var(--soft);border-radius:20px;padding:26px 24px;font-size:19px;font-weight:600;counter-increment:s}
.steps li::before{content:"0" counter(s);display:block;font-family:'Anton',sans-serif;font-size:44px;line-height:1;margin-bottom:12px;background:var(--gold-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
@media(max-width:720px){.steps{grid-template-columns:1fr}}

/* lookbook + tabs */
.lb-intro{max-width:60ch;margin:-8px 0 26px;color:#3a3a3a}
.tabbar{position:sticky;top:68px;z-index:30;background:#fff;padding:12px 0;margin-bottom:22px;border-bottom:1px solid var(--line)}
.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;background:var(--soft);padding:6px;border-radius:999px;max-width:620px}
.tab{border:0;background:transparent;border-radius:999px;padding:13px 10px;font:700 15px 'Jost',sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;color:var(--ink);display:flex;justify-content:center;gap:8px;align-items:baseline;transition:background .2s,color .2s}
.tab .tab-p{font-weight:500;letter-spacing:0;opacity:.75}
.tab[aria-selected="true"]{background:var(--ink);color:#fff}
.tab[aria-selected="true"] .tab-p{opacity:1;background:var(--gold-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.tab:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
@media(max-width:520px){.tab{flex-direction:column;align-items:center;gap:0;padding:9px 6px;font-size:13px}.tabbar{top:68px}}
.panel-head{display:flex;gap:12px;align-items:baseline;margin-bottom:18px;font-size:18px}
.panel-head span{color:#6b6b6b;font-size:15px}
.grid{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:22px 18px}
@media(max-width:980px){.grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:640px){.grid{grid-template-columns:repeat(2,1fr);gap:18px 12px}}
.card-btn{display:block;width:100%;border:0;padding:0;background:var(--soft);border-radius:16px;overflow:hidden;aspect-ratio:4/5;cursor:zoom-in}
.card-btn img{width:100%;height:100%;object-fit:cover;transition:transform .35s}
.card-btn:hover img{transform:scale(1.05)}
.card-txt{display:flex;gap:8px;align-items:baseline;margin-top:10px;font-weight:600;font-size:16px;line-height:1.25}
.num{font-family:'Anton',sans-serif;font-weight:400;font-size:18px}
.card-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px;font-size:13px;color:#555}
.tag{font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:11px;padding:3px 9px;border-radius:999px}
.tag-simple{background:var(--sage)}
.tag-classic{background:var(--coral)}
.tag-glam{background:var(--gold-grad)}
.occ{font-weight:600;font-size:11px;letter-spacing:.06em;padding:2px 9px;border-radius:999px;border:1.5px solid var(--ink);text-transform:uppercase}
.lb-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}

/* lightbox */
.lbox{position:fixed;inset:0;background:rgba(20,20,20,.94);z-index:100;display:none;align-items:center;justify-content:center;padding:20px}
.lbox.open{display:flex}
.lbox figure{max-width:min(92vw,720px);color:#fff;text-align:center}
.lbox img{max-height:74vh;margin:0 auto;border-radius:14px}
.lbox figcaption{margin-top:14px}
.lbox .t{font-size:20px;font-weight:600}
.lbox .m{font-size:14px;opacity:.8;margin-top:2px}
.lbox button{position:absolute;background:rgba(255,255,255,.12);color:#fff;border:0;width:48px;height:48px;border-radius:50%;font-size:24px;cursor:pointer}
.lb-close{top:18px;right:18px}.lb-prev{left:14px;top:50%;transform:translateY(-50%)}.lb-next{right:14px;top:50%;transform:translateY(-50%)}

/* fine print */
.fine{background:var(--soft);border-radius:20px;padding:26px 26px;font-size:15px;color:#333}
.fine p+p{margin-top:10px}
.fine em{font-style:italic}

/* cta */
.cta{background:var(--ink);color:#fff;border-radius:26px;padding:54px 30px;text-align:center}
.cta h2{margin-bottom:10px}
.cta p{font-size:18px;margin-bottom:24px;opacity:.9}
.cta .btn-line{border-color:#fff;color:#fff}
.cta-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

/* footer */
footer{padding:50px 0 30px;font-size:15px}
.f-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:28px}
footer h4{font-size:13px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:10px}
footer ul{list-style:none}footer li{margin:5px 0}
footer a{text-decoration:none}footer a:hover{text-decoration:underline}
.f-bottom{border-top:1px solid var(--line);margin-top:34px;padding-top:18px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:13px;color:#666}
@media(max-width:820px){.f-grid{grid-template-columns:1fr 1fr}}

/* bottom bar */
.bbar{position:fixed;left:0;right:0;bottom:0;z-index:50;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 18px}
.bbar strong{font-size:16px;letter-spacing:.04em}
.bbar strong span{background:var(--gold-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.bbar .btn{padding:12px 22px}

/* ===== BLACK THEME (matches Set 80 page) ===== */
:root{--ink:#fff;--white:#000;--line:#262626;--soft:#121212;--muted:#9a9a9a}
body{background:#000;color:#fff;font-family:'Archivo',system-ui,sans-serif}
.display,h1,h2{font-family:'Archivo',sans-serif;font-weight:800;font-stretch:112%;letter-spacing:-.01em;line-height:.95}
.eyebrow,.sec-num{font-family:'Archivo',sans-serif;color:var(--muted);font-weight:500;letter-spacing:.32em;font-size:14px}
header.site{background:rgba(0,0,0,.94);border-bottom:1px solid var(--line)}
nav.main a{color:#fff}
@media(max-width:1240px){nav.main{background:#000;border-bottom:1px solid var(--line)}nav.main a{border-bottom:1px solid var(--line)}}
.menu-btn{color:#fff;font-family:'Archivo',sans-serif;letter-spacing:.2em;text-transform:uppercase}
.logo img{filter:invert(1)}
.btn{border-radius:0;letter-spacing:.18em;text-transform:uppercase;font-size:13px;font-family:'Archivo',sans-serif}
.btn-gold{color:#000}
.btn-line{border:1.5px solid #fff;color:#fff}
.hero p.lede{color:#fff}
.hero .from{color:#fff}
.hero-img,.card-btn{border-radius:0;background:#111}
.price-card{border:1.5px solid var(--line);border-radius:0;background:#0b0b0b;color:#fff}
.price-card:hover{background:#151515;border-color:var(--gold)}
.price-card:nth-child(3){background:#0b0b0b;border-color:var(--gold)}
.price-card:nth-child(3):hover{background:#151515}
.pc-l{color:var(--muted);letter-spacing:.3em;font-weight:500}
.pc-p{font-family:'Archivo',sans-serif;font-weight:800;font-stretch:112%}
.pc-go{letter-spacing:.14em;text-transform:uppercase;font-size:12px}
.price-note{color:var(--muted)}
.steps li{background:#0b0b0b;border-left:3px solid var(--gold);border-radius:0}
.steps li::before{font-family:'Archivo',sans-serif;font-weight:800}
/* lookbook intro */
.lb-intro{color:#fff;max-width:none;margin:0 0 22px;font-size:18px}
.lb-new{font-weight:700;letter-spacing:.3em;text-transform:uppercase;font-size:13px;margin:0 0 26px}
.note{background:#121212;border-left:4px solid var(--gold);padding:20px 24px;margin:0 0 18px;color:#a9a9a9;font-size:17px;line-height:1.6}
.note strong{color:#fff}
/* tabs */
.tabbar{background:#000;border-bottom:1px solid var(--line);margin-top:30px}
.tabs{background:#121212;border-radius:0;padding:4px}
.tab{border-radius:0;color:#fff;font-family:'Archivo',sans-serif;letter-spacing:.2em}
.tab[aria-selected="true"]{background:var(--gold-grad);color:#000}
.tab[aria-selected="true"] .tab-p{background:none;-webkit-background-clip:initial;background-clip:initial;color:#000}
.panel-head{color:#fff}.panel-head span{color:var(--muted)}
/* cards like Set 80: name label then big number */
.grid{gap:34px 12px}
.card-txt{flex-direction:column-reverse;align-items:flex-start;gap:8px;margin-top:16px}
.card-txt .name{color:var(--muted);font-weight:500;letter-spacing:.28em;text-transform:uppercase;font-size:13px;line-height:1.6}
.card-txt .num{font-family:'Archivo',sans-serif;font-weight:800;font-stretch:112%;font-size:44px;line-height:1;color:#fff}
.card-meta{margin-top:10px}
.tag{border-radius:0;color:#000}
.occ{border-radius:0;background:transparent}
.occ-christmas{border-color:#E0574F;color:#F08A84}
.occ-newyear{border-color:var(--gold);color:var(--gold)}
/* fine print, cta, footer */
.fine{background:#121212;border-left:4px solid var(--gold);border-radius:0;color:#a9a9a9}
.fine em{color:#fff;font-style:normal;font-weight:600}
.cta{background:#0b0b0b;border:1px solid var(--line);border-radius:0}
footer{border-top:1px solid var(--line);color:#cfcfcf}
footer h4{color:var(--muted);font-weight:500;letter-spacing:.3em}
.f-bottom{border-color:var(--line);color:var(--muted)}
.bbar{background:#0a0a0a;border-top:2px solid var(--gold)}
.bbar strong{font-family:'Archivo',sans-serif;font-weight:800;font-size:20px}
.bbar .btn{letter-spacing:.2em}
.lbox{background:rgba(0,0,0,.96)}
.wm{font-family:'Archivo',sans-serif;font-weight:800;font-stretch:112%;font-size:19px;letter-spacing:.02em;color:#fff;white-space:nowrap}
.wm i{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;font-size:22px;background:var(--gold-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.banner{background:#000;color:#fff;border-bottom:1px solid var(--line)}
.logo{text-decoration:none}
@media(max-width:1380px){nav.main{display:none;position:absolute;top:68px;left:0;right:0;flex-direction:column;gap:0;padding:8px 22px 18px}nav.main.open{display:flex}nav.main a{padding:11px 0}.menu-btn{display:block}.hdr>.btn{display:none}}
@media(max-width:520px){.bbar strong{font-size:16px}.bbar .btn{padding:12px 16px;font-size:12px;letter-spacing:.14em;white-space:nowrap}.wm{font-size:16px}.wm i{font-size:19px}}
.occ{border-color:var(--gold);color:var(--gold)}
.occrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.occrow[hidden]{display:none}
.ochip{background:transparent;border:1.5px solid var(--line);color:#cfcfcf;font:600 12px 'Archivo',sans-serif;letter-spacing:.18em;text-transform:uppercase;padding:9px 14px;cursor:pointer}
.ochip[aria-pressed="true"]{border-color:var(--gold);color:var(--gold)}
.ochip:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.card[hidden]{display:none}
.empty{color:var(--muted);padding:20px 0}
.osoon{align-self:center;color:var(--muted);font-size:12px;letter-spacing:.18em;text-transform:uppercase;margin-left:6px}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>{% endraw %}
</head>
<body data-default="{{ deftier }}">

<div class="banner" aria-label="Announcements">
  <div class="marquee">
    <span><a href="#lookbook" class="hl">{{ hs.page_title | upper }} · FROM ${{ hs.prices.simple }} — Tap to see the lookbook</a></span>
    <span>$50 REWARDS HEAD START FOR NEW CLIENTS</span>
    <span>5-HOUR VALIDATED PARKING WITH $100+ CASH PURCHASE</span>
    <span>GROUP BOOKINGS · BRIDAL · BIRTHDAYS</span>
    <span>WALK-INS WELCOME · HISTORIC CORE, DTLA</span>
    <span><a href="tel:+12132660077" data-ev="call_click">213-266-0077</a></span>
    <span><a href="#lookbook" class="hl">{{ hs.page_title | upper }} · FROM ${{ hs.prices.simple }} — Tap to see the lookbook</a></span>
    <span>$50 REWARDS HEAD START FOR NEW CLIENTS</span>
    <span>5-HOUR VALIDATED PARKING WITH $100+ CASH PURCHASE</span>
    <span>GROUP BOOKINGS · BRIDAL · BIRTHDAYS</span>
    <span>WALK-INS WELCOME · HISTORIC CORE, DTLA</span>
    <span><a href="tel:+12132660077" data-ev="call_click">213-266-0077</a></span>
  </div>
</div>

<header class="site">
  <div class="wrap hdr">
    <a class="logo" href="/" aria-label="Polished Nail Bar DTLA home"><span class="wm">Polished <i>Nail Bar</i> · DTLA</span></a>
    <nav class="main" id="mainnav" aria-label="Main">
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/services/">Services</a>
      <a href="/holiday-set/" aria-current="page">Holiday Set</a>
      <a href="/gallery/">Gallery</a>
      <a href="/reviews/">Reviews</a>
      <a href="/group-booking/">Group Booking</a>
      <a href="/the-latest/">The Latest</a>
      <a href="/journal/">Journal</a>
      <a href="/careers/">Careers</a>
      <a href="/policies/">Policies</a>
      <a href="/faq/">FAQ</a>
      <a href="/contact/">Contact</a>
    </nav>
    <a class="btn btn-gold" href="{{ hs.book_url }}" data-ev="book_click">Book</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mainnav">Menu</button>
  </div>
</header>

<main>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">01 — {{ hs.eyebrow }}</p>
        <h1 class="display">Holiday <span class="g">Set</span></h1>

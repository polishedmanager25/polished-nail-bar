        </div>
      </div>
      <div class="hero-img">
        <img src="{{ hs.hero_image }}" alt="{{ hs.page_title }} — short Gel-X with nail art at Polished Nail Bar DTLA" width="900" height="1125">
      </div>
    </div>
  </section>

  <section id="pricing">
    <div class="wrap">
      <p class="sec-num">02 — Pricing</p>
      <h2 class="display">Pick your tier</h2>
      <div class="prices">
{%- for t in tiers %}
      <a class="price-card" href="#{{ t[0] }}" data-jump="{{ t[0] }}"><span class="pc-l">{{ t[1] }}</span><span class="pc-p">${{ t[2] }}</span><span class="pc-go">See {{ t[1] }} looks →</span></a>
{%- endfor %}
      </div>
      <p class="price-note">{{ hs.price_note }}</p>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <p class="sec-num">03 — How it works</p>
      <h2 class="display">Three steps</h2>
